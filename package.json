{
  "name": "n8n-nodes-miro",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Miro's REST API v2, providing 12 resources and 60+ operations for whiteboard automation, visual collaboration, and team productivity workflows.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-miro.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-miro#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-miro/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "miro",
    "whiteboard",
    "collaboration",
    "visual-collaboration",
    "workflow-automation",
    "sticky-notes",
    "diagrams",
    "brainstorming",
    "remote-work",
    "team-collaboration"
  ],
  "main": "dist/nodes/Miro/Miro.node.js",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "LICENSING_FAQ.md",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MiroOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Miro/Miro.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && npm run copy:icons",
    "copy:icons": "cp -r nodes/**/*.svg dist/nodes/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.35.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
